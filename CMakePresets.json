{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SHINSHU_BUILD_TESTS": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SHINSHU_BUILD_TESTS": "ON" }
    },
    {
      "name": "debug-sanitizers",
      "displayName": "Debug with ASan and UBSan (Ninja)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug-sanitizers",
      "cacheVariables": { "SHINSHU_ENABLE_SANITIZERS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "debug-sanitizers", "configurePreset": "debug-sanitizers" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "debug-sanitizers", "configurePreset": "debug-sanitizers", "output": { "outputOnFailure": true } }
  ]
}
